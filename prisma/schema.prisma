// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstimationStatus {
  DRAFT
  FINAL
}

// HubSpot's standard Sales Pipeline deal stages, in order.
enum OpportunityPhase {
  QUALIFIED_TO_BUY
  DEMO_SCHEDULED
  PROPOSAL_SENT
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
}

model Estimation {
  id          String           @id @default(cuid())
  clientName  String
  projectName String?
  ownerName   String?
  status      EstimationStatus @default(DRAFT)

  // Sales-pipeline tracking for this opportunity. closedWon/closedWonDeadline
  // are stored independently of opportunityPhase (not derived from it) - set
  // both if you want "Closed Won" to show the same way everywhere.
  opportunityPhase  OpportunityPhase @default(QUALIFIED_TO_BUY)
  closedWon         Boolean          @default(false)
  closedWonDeadline DateTime?

  // Full estimation state: workstreams, line items, complexity choices,
  // ElixirSync checkboxes, Third Party lines, rates, PM %, subscriptions.
  // Kept as JSON (shape enforced in src/lib/types.ts) so it can evolve
  // without a migration on every field. See EstimationState in that file.
  data Json @db.JsonB

  totalHours Float @default(0)
  totalPrice Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions EstimationVersion[]

  @@index([clientName])
  @@index([updatedAt])
}

// A read-only snapshot of an Estimation, taken every time it's created or
// saved, so the full save history can be browsed and any earlier point
// restored. Never updated in place - only inserted and (rarely) deleted
// along with its parent Estimation.
model EstimationVersion {
  id           String     @id @default(cuid())
  estimationId String
  estimation   Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)

  clientName        String
  projectName       String?
  ownerName         String?
  status            EstimationStatus
  opportunityPhase  OpportunityPhase
  closedWon         Boolean
  closedWonDeadline DateTime?
  data              Json     @db.JsonB
  totalHours        Float
  totalPrice        Float

  /** Set only when this snapshot was created by restoring an earlier one (e.g. "Restored from 19 Oct 2026, 14:32"). */
  note String?

  createdAt DateTime @default(now())

  @@index([estimationId, createdAt])
}
